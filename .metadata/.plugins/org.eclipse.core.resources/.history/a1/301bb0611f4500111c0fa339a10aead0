	// Part 02 Circuit Breaker
    @Override
    public OrderResponse createOrder(OrderRequest request) {

        UserResponse user = getUser(request.getUserId());
        ProductResponse product = getProduct(request.getProductId());

        if (user == null) {
            return fail("USER_SERVICE_DOWN", request);
        }

        if (product == null) {
            return fail("PRODUCT_SERVICE_DOWN", request);
        }

        return success(user, product);
    }
