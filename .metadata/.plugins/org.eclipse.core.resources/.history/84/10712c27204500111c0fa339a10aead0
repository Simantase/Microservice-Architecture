	// Part 02 Circuit Breaker
	@Override
	public OrderResponse createOrder(OrderRequest request) {

	    UserResponse user = userClient.getUserById(request.getUserId());
	    ProductResponse product = productClient.getProductById(request.getProductId());

	    // ❌ USER SERVICE FAILURE HANDLING
	    if (user == null) {
	        return OrderResponse.builder()
	                .userId(request.getUserId())
	                .productId(request.getProductId())
	                .status("ORDER_FAILED_USER_SERVICE_DOWN")
	                .build();
	    }

	    // ❌ PRODUCT SERVICE FAILURE HANDLING
	    if (product == null) {
	        return OrderResponse.builder()
	                .userId(user.getUserId())
	                .userName(user.getUserName())
	                .productId(request.getProductId())
	                .status("ORDER_FAILED_PRODUCT_SERVICE_DOWN")
	                .build();
	    }
	    return OrderResponse.builder()
	            .userId(user.getUserId())
	            .userName(user.getUserName())
	            .productId(product.getProductId())
	            .productName(product.getProductName())
	            .productPrice(product.getProductPrice())
	            .status("ORDER_CREATED")
	            .build();
	}
	@CircuitBreaker(name = "userService", fallbackMethod = "userFallback")
	public UserResponse getUser(int userId) {
	    return userClient.getUserById(userId);
	}

	public UserResponse userFallback(int userId, Throwable t) {
	    log.error("User Service failed: {}", t.getMessage());
	    return null; // or cached response / throw exception
	}

}