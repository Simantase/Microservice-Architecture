	// Part 03 Saga Design Pattern
	public OrderResponse createOrder(OrderRequest request) {

	    UserResponse user = null;
	    ProductResponse product = null;

	    try {
	        // Step 1: Validate User
	        user = userClient.getUserById(request.getUserId());
	        if (user == null) throw new RuntimeException("User failed");

	        // Step 2: Validate Product
	        product = productClient.getProductById(request.getProductId());
	        if (product == null) throw new RuntimeException("Product failed");

	        // Step 3: Create Order
	        OrderResponse order = OrderResponse.builder()
	                .userId(user.getUserId())
	                .productId(product.getProductId())
	                .status("ORDER_CREATED")
	                .build();

	        return order;

	    } catch (Exception e) {

	        // 🔁 COMPENSATION LOGIC (Saga rollback)
	        return OrderResponse.builder()
	                .userId(request.getUserId())
	                .productId(request.getProductId())
	                .status("ORDER_FAILED_COMPENSATED")
	                .build();
	    }
	}
