spring.application.name=orderservice
server.port=8080
eureka.client.service-url.defaultZone=http://localhost:8761/eureka

# ================================
# RESILIENCE4J CIRCUIT BREAKER
# ================================

# PRODUCT SERVICE
resilience4j.circuitbreaker.instances.productService.slidingWindowSize=3
resilience4j.circuitbreaker.instances.productService.minimumNumberOfCalls=2
resilience4j.circuitbreaker.instances.productService.failureRateThreshold=50
resilience4j.circuitbreaker.instances.productService.waitDurationInOpenState=5s
resilience4j.circuitbreaker.instances.productService.permittedNumberOfCallsInHalfOpenState=2
resilience4j.circuitbreaker.instances.productService.automaticTransitionFromOpenToHalfOpenEnabled=true


# USER SERVICE
resilience4j.circuitbreaker.instances.userService.slidingWindowSize=5
resilience4j.circuitbreaker.instances.userService.minimumNumberOfCalls=3
resilience4j.circuitbreaker.instances.userService.failureRateThreshold=50
resilience4j.circuitbreaker.instances.userService.waitDurationInOpenState=10s